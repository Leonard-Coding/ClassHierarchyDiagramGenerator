	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=AD570D22D0B7064B8A4C7A1547623A17/Text/@EntryValue">using Moq;&#xD;
using S4.TestUtils;&#xD;
using Xunit;&#xD;
&#xD;
namespace $CurrentNamespace$&#xD;
{&#xD;
    public class $TypeOfSUT$Facts&#xD;
    {&#xD;
        private $TypeOfSUT$ SUT { get; set; }        &#xD;
&#xD;
        [Fact]&#xD;
        public void It_throws_ArgumentNullExceptions_for_its_dependencies()&#xD;
        {&#xD;
            AutomatedTesting.TestConstructorNullChecks(typeof ($TypeOfSUT$));&#xD;
        }&#xD;
&#xD;
        [Fact]&#xD;
        public void It_$END$()&#xD;
        {&#xD;
            WhenSutIsCreated();&#xD;
        }&#xD;
&#xD;
        private void GivenDefaultDependencies()&#xD;
        {&#xD;
        }&#xD;
&#xD;
		private void WhenSutIsCreated()&#xD;
        {&#xD;
            SUT = new $TypeOfSUT$();&#xD;
        }&#xD;
    }&#xD;
}  </s:String>
