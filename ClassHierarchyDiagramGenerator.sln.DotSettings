	<s:String x:Key="/Default/CodeStyle/CSharpFileLayoutPatterns/Pattern/@EntryValue">&lt;?xml version="1.0" encoding="utf-16"?&gt;

&lt;Patterns xmlns="urn:schemas-jetbrains-com:member-reordering-patterns" StaticFieldReorderingPolicy="Relaxed"&gt;

    &lt;!-- XUnit Fact Files ##################################################################### --&gt;

    &lt;TypePattern DisplayName="xUnit.net Test Classes"
                 RemoveRegions="All"&gt;

        &lt;TypePattern.Match&gt;
            &lt;And&gt;
                &lt;Kind Is="Class" /&gt;
                &lt;Name Is=".*Facts" /&gt;                
            &lt;/And&gt;
        &lt;/TypePattern.Match&gt;
        
       &lt;Entry DisplayName="Fields"&gt;
            &lt;Entry.Match&gt;
                &lt;Or&gt;
                    &lt;Kind Is="Field" /&gt;
                    &lt;Kind Is="Constant" /&gt;
                &lt;/Or&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Readonly /&gt;
                &lt;Static /&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Constructors"&gt;
            &lt;Entry.Match&gt;
                &lt;Kind Is="Constructor" /&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Dispose"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="Dispose" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Properties"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Property" /&gt;                    
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Events"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Event" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Fact/Theory methods"&gt;
            &lt;Entry.Match&gt;
                &lt;Or&gt;
                    &lt;And&gt;
                        &lt;Kind Is="Method" /&gt;
                        &lt;HasAttribute Name="Xunit.FactAttribute" Inherited="true" /&gt;
                    &lt;/And&gt;
                    &lt;And&gt;
                        &lt;Kind Is="Method" /&gt;
                        &lt;HasAttribute Name="Xunit.TheoryAttribute" Inherited="true" /&gt;
                    &lt;/And&gt;
                    &lt;And&gt;
                        &lt;Kind Is="Method" /&gt;
                        &lt;HasAttribute Name="S4.TestUtils.XunitExtensions.RetryFactAttribute" Inherited="false" /&gt;
                    &lt;/And&gt;
                    &lt;And&gt;
                        &lt;Kind Is="Method" /&gt;
                        &lt;HasAttribute Name="S4.TestUtils.XunitExtensions.RetryTheoryAttribute" Inherited="false" /&gt;
                    &lt;/And&gt;
                &lt;/Or&gt;                
            &lt;/Entry.Match&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="BuildDefaultSetup"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="BuildDefaultSetup" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="DefaultSetup"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="DefaultSetup" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="With methods"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="With.*" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Build"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="Build" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;
        &lt;/Entry&gt;        

        &lt;Entry DisplayName="Given methods"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="Given.*" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="When methods"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="When.*" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Then methods"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="Then.*" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Everything else"/&gt;

    &lt;/TypePattern&gt;

    &lt;!-- Default Class Files ####################################################################################### --&gt;

    &lt;TypePattern DisplayName="Default Classes"&gt;

        &lt;Entry DisplayName="Fields"&gt;
            &lt;Entry.Match&gt;
                &lt;Or&gt;
                    &lt;Kind Is="Field" /&gt;
                    &lt;Kind Is="Constant" /&gt;
                &lt;/Or&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Readonly /&gt;
                &lt;Static /&gt;
                &lt;Access Order="Private Public Internal Protected ProtectedInternal"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Fields"&gt;
            &lt;Entry.Match&gt;                
                    &lt;Kind Is="Field" /&gt;                
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Readonly /&gt;
                &lt;Access Order="Private Public Internal Protected ProtectedInternal"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Constructors"&gt;
            &lt;Entry.Match&gt;
                &lt;Kind Is="Constructor" /&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Dispose"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Method" /&gt;
                    &lt;Name Is="Dispose" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;
            
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Properties"&gt;
            &lt;Entry.Match&gt;                
                    &lt;Kind Is="Property" /&gt;                
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Indexer"&gt;
            &lt;Entry.Match&gt;
                &lt;Kind Is="Indexer" /&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Events"&gt;
            &lt;Entry.Match&gt;
                &lt;And&gt;
                    &lt;Kind Is="Event" /&gt;
                &lt;/And&gt;
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Methods"&gt;
            &lt;Entry.Match&gt;                
                &lt;Kind Is="Method" /&gt;                
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Everything else"&gt;

            &lt;Entry.SortBy&gt;
                &lt;Static/&gt;
                &lt;Access Order="Public Internal Protected ProtectedInternal Private"/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;

        &lt;Entry DisplayName="Nested types"&gt;
            &lt;Entry.Match&gt;                
                    &lt;Kind Is="Type" /&gt;                
            &lt;/Entry.Match&gt;

            &lt;Entry.SortBy&gt;
                &lt;Access Order="Public Internal Private"/&gt;
                &lt;Static/&gt;
            &lt;/Entry.SortBy&gt;
        &lt;/Entry&gt;        

    &lt;/TypePattern&gt;

&lt;/Patterns&gt;</s:String>
