	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=137D9EAD34457D41B89A45A64C269B6A/Text/@EntryValue">[Fact]&#xD;
public void It_provides_a_custom_string_representation()&#xD;
{&#xD;
    GivenDefaultDependencies();&#xD;
    WhenSutIsCreated();&#xD;
    Assert.NotEqual(_sut.GetType()&#xD;
                        .ToString(),&#xD;
                    _sut.ToString());&#xD;
}  </s:String>
